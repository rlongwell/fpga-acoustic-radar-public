  (text "JE GPIO  |  3.3 V  |  48 kHz I2S" (at 231 21 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid ea8f7fdf-414b-5caf-b07c-3ae0ae767b0a))
  (polyline (pts (xy 17 151) (xy 280 151)) (stroke (width 0.24) (type default)) (uuid 1312806b-b1eb-52bf-bb65-4225c29270df))
  (text "ASSEMBLY NOTES" (at 18 157 0) (effects (font (size 1.8 1.8) bold) (justify left)) (uuid 29b8498b-c9e2-5823-bb35-6df08a16b61c))
  (text "A  Breakout terminals are identified by silkscreen; physical pad order and onboard components require inspection." (at 18 162 0) (effects (font (size 1.43 1.43)) (justify left)) (uuid 1ec9056f-5cb6-5556-9d7f-40c9a70bfe6c))
  (text "B  Fit one 100k SD-to-GND pull-down per independent SD unless an equivalent is confirmed onboard." (at 18 167 0) (effects (font (size 1.43 1.43)) (justify left)) (uuid 9296f1ee-7e47-56fe-83ed-f3b50b9df2ee))
  (text "C  Fit 100nF X7R directly across each module VDD/GND unless adequate local bypass is confirmed onboard." (at 18 172 0) (effects (font (size 1.43 1.43)) (justify left)) (uuid eb28d08a-598e-5911-8902-6b4d8113eb5d))
  (text "D  +3V3 and GND are common rails. No 5 V, no tied SD lines, and no added clock resistors for the initial build." (at 18 177 0) (effects (font (size 1.43 1.43)) (justify left)) (uuid bfacabb0-65e5-54b0-b2f3-22b016f62abe))
  (text "E  Labels of the same name are connected. R/C numbers match their microphone numbers." (at 18 182 0) (effects (font (size 1.43 1.43)) (justify left)) (uuid fc1807a4-9a23-5d71-b377-10f4e561a9ba))
