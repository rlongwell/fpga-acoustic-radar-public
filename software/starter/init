#!/bin/sh
export PATH=/bin
/bin/busybox mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox hostname zybo
if /bin/busybox insmod /lib/uio_pdrv_genirq.ko of_id=generic-uio; then
    /opt/zybo/radar/radar-stream --self-test
fi
# The USB dashboard expects a local getty and a root prompt. Networking is off.
while true; do
    /bin/busybox getty -L -i -l /radar-login 115200 ttyPS0 vt100
    /bin/busybox sleep 1
done
