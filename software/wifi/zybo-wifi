#!/usr/bin/python3
"""Join a personal Wi-Fi network using the Zybo's physical console."""
from getpass import getpass
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import tempfile

BASE = Path("/opt/zybo/wifi")
CONF = Path("/etc/zybo/wifi.conf")
INIT = "/etc/init.d/S65zybo-wifi"


def configure():
    if not sys.stdin.isatty():
        raise ValueError("Run configure in an interactive Zybo terminal.")
    ssid = input("Wi-Fi network name (exact case): ").encode("utf-8")
    if not 1 <= len(ssid) <= 32:
        raise ValueError("The Wi-Fi name must be 1–32 bytes.")
    mode = input("Is the network WPA3-only? [y/N]: ").strip().lower()
    password = getpass("Wi-Fi password: ")
    if not 8 <= len(password) <= 63 or any(not 32 <= ord(c) <= 126 for c in password):
        raise ValueError("Use a Wi-Fi passphrase of 8–63 printable ASCII characters.")
    if mode in {"y", "yes"}:
        if '"' in password:
            raise ValueError('This setup tool does not support double quotes in WPA3-only passwords.')
        security = f'    key_mgmt=SAE\n    ieee80211w=2\n    sae_password="{password}"'
    elif mode in {"", "n", "no"}:
        psk = hashlib.pbkdf2_hmac("sha1", password.encode(), ssid, 4096, 32).hex()
        security = f"    key_mgmt=WPA-PSK\n    psk={psk}"
    else:
        raise ValueError("Answer y or n for WPA3-only.")
    CONF.parent.mkdir(mode=0o700, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=CONF.parent, delete=False) as out:
        out.write(f"country=US\nctrl_interface=/run/zybo-wifi\nnetwork={{\n"
                  f"    ssid={ssid.hex()}\n    scan_ssid=1\n{security}\n}}\n")
    os.replace(out.name, CONF)
    subprocess.run([INIT, "restart"], check=True)
    print("Wi-Fi saved. Check 'zybo-wifi status' for the connection and IP address.")


def status():
    print("Network configuration:", "saved" if CONF.is_file() else "not saved")
    print("USB Wi-Fi driver:", "ready" if Path("/sys/bus/usb/drivers/mt76x0u").is_dir()
          else "not available in this boot")
    devices = [dev for dev in Path("/sys/class/net").iterdir() if
               (dev / "device/driver").resolve().name == "mt76x0u"]
    if not devices:
        print("Panda adapter: not detected")
    for dev in devices:
        print(f"Wireless interface: {dev.name}", flush=True)
        env = dict(os.environ, LD_LIBRARY_PATH=str(BASE / "lib"))
        subprocess.run([str(BASE / "bin/wpa_cli"), "-p", "/run/zybo-wifi",
                        "-i", dev.name, "status"], env=env)
        subprocess.run(["ip", "-4", "addr", "show", dev.name])


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["configure"] and os.geteuid() == 0:
            configure()
        elif sys.argv[1:] in ([], ["status"]):
            status()
        else:
            raise ValueError("Usage: zybo-wifi status | zybo-wifi configure (root)")
    except (ValueError, OSError, KeyboardInterrupt, subprocess.CalledProcessError) as error:
        print(f"Wi-Fi setup: {error}", file=sys.stderr)
        sys.exit(1)
